#version 450
#define SPIRV_CROSS_CONSTANT_ID_256 1u
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct ShaderDataStruct
{
    float resX;
    float resY;
    float edgeThreshold;
    float padding;
};

const ivec2 _625[4] = ivec2[](ivec2(0), ivec2(1, 0), ivec2(0, 1), ivec2(1));

struct ControlBufferStruct
{
    uint itemCount;
    uint shapeCandidateCount;
    uint blendLocationCount;
    uint deferredBlendItemCount;
};

#ifndef SPIRV_CROSS_CONSTANT_ID_256
#define SPIRV_CROSS_CONSTANT_ID_256 0u
#endif
const uint CORE_BACKEND_TYPE = SPIRV_CROSS_CONSTANT_ID_256;
uniform float CORE_FLIP_NDC ;

layout(std140) uniform s0_b0
{
    ShaderDataStruct shaderData;
} _s0_b0;

layout(binding = 11, std430) buffer s0_b4
{
    ControlBufferStruct controlBuffer;
} _s0_b4;

layout(binding = 11, std430) buffer s0_b3
{
    uint shapeCandidates[];
} _s0_b3;

uniform sampler2D s0_b1;
layout(binding = 11, r8ui) uniform writeonly uimage2D s0_b2;

shared uvec2 sharedPackedEdges[256];

float RgbToLuma(vec3 rgb)
{
    float luma = dot(sqrt(rgb), vec3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625));
    return luma;
}

vec2 EdgeLuma(int xx, int yy, float pixelLumas[8])
{
    float indexable[8] = pixelLumas;
    float indexable_1[8] = pixelLumas;
    float indexable_2[8] = pixelLumas;
    float indexable_3[8] = pixelLumas;
    return vec2(abs(indexable[uint(xx) + (uint(yy) * 3u)] - indexable_1[(uint(xx) + 1u) + (uint(yy) * 3u)]), abs(indexable_2[uint(xx) + (uint(yy) * 3u)] - indexable_3[uint(xx) + ((uint(yy) + 1u) * 3u)]));
}

uint PackEdges4(vec4 edges)
{
    return packUnorm4x8(edges);
}

vec4 UnpackEdges4(uint _packed)
{
    return unpackUnorm4x8(_packed);
}

float LocalContrastH(int xx, int yy, vec2 neighbors[3][3])
{
    vec2 indexable[3][3] = neighbors;
    vec2 indexable_1[3][3] = neighbors;
    return max(indexable[xx][uint(yy) + 1u].x, indexable_1[uint(xx) + 1u][uint(yy) + 1u].x) * 0.100000001490116119384765625;
}

float LocalContrastV(int xx, int yy, vec2 neighbors[3][3])
{
    vec2 indexable[3][3] = neighbors;
    vec2 indexable_1[3][3] = neighbors;
    return max(indexable[xx + 1][yy].y, indexable_1[xx + 1][yy + 1].y) * 0.100000001490116119384765625;
}

uint PackEdgesBinary(vec4 edges)
{
    return ((uint(edges.x) | (uint(edges.y) << 1u)) | (uint(edges.z) << 2u)) | (uint(edges.w) << 3u);
}

void main()
{
    ivec2 pixelPos = (((ivec2(gl_WorkGroupID.xy) * ivec2(14)) + ivec2(gl_LocalInvocationID.xy)) - ivec2(1)) * ivec2(2);
    uint centerAddr2x2 = gl_LocalInvocationID.x + (gl_LocalInvocationID.y * 16u);
    float edgeThreshold = _s0_b0.shaderData.edgeThreshold;
    bool inOutputKernel = !any(bvec4(gl_LocalInvocationID.x == 15u, gl_LocalInvocationID.x == 0u, gl_LocalInvocationID.y == 15u, gl_LocalInvocationID.y == 0u));
    uvec4 outEdges = uvec4(0u);
    ivec2 texSize = textureSize(s0_b1, 0);
    float pixelLumas[8];
    for (uint ii = 0u; ii < 8u; ii++)
    {
        ivec2 offset = ivec2(int(ii % 3u), int(ii / 3u));
        vec3 color = texelFetch(s0_b1, pixelPos + offset, 0).xyz;
        pixelLumas[ii] = RgbToLuma(color);
    }
    vec2 qe0 = EdgeLuma(0, 0, pixelLumas);
    vec2 qe1 = EdgeLuma(1, 0, pixelLumas);
    vec2 qe2 = EdgeLuma(0, 1, pixelLumas);
    vec2 qe3 = EdgeLuma(1, 1, pixelLumas);
    vec4 arg = vec4(qe0.x, qe1.x, qe2.x, qe3.x);
    vec4 arg_1 = vec4(qe0.y, qe1.y, qe2.y, qe3.y);
    sharedPackedEdges[centerAddr2x2] = uvec2(PackEdges4(arg), PackEdges4(arg_1));
    barrier();
    if (inOutputKernel)
    {
        uvec2 topPackedEdges = sharedPackedEdges[centerAddr2x2 - 16u];
        uvec2 leftPackedEdges = sharedPackedEdges[centerAddr2x2 - 1u];
        vec2 topRow = UnpackEdges4(topPackedEdges.y).zw;
        vec2 leftColumn = UnpackEdges4(leftPackedEdges.x).yw;
        bool someNonZeroEdges = any(greaterThan((vec4(qe0, qe1) + vec4(qe2, qe3)) + vec4(topRow, leftColumn), vec4(0.0)));
        if (someNonZeroEdges)
        {
            uvec2 valPacked = sharedPackedEdges[(centerAddr2x2 - 16u) - 1u];
            vec2 neighbors[3][3];
            neighbors[0][0] = vec2(UnpackEdges4(valPacked.x).w, UnpackEdges4(valPacked.y).w);
            valPacked = sharedPackedEdges[centerAddr2x2 - 16u];
            vec4 topV = UnpackEdges4(valPacked.x);
            vec4 topH = UnpackEdges4(valPacked.y);
            neighbors[1][0] = vec2(topV.z, topH.z);
            neighbors[2][0] = vec2(topV.w, topH.w);
            valPacked = sharedPackedEdges[centerAddr2x2 - 1u];
            vec4 leftV = UnpackEdges4(valPacked.x);
            vec4 leftH = UnpackEdges4(valPacked.y);
            neighbors[0][1] = vec2(leftV.y, leftH.y);
            neighbors[0][2] = vec2(leftV.w, leftH.w);
            valPacked = sharedPackedEdges[centerAddr2x2 + 16u];
            vec4 botV = UnpackEdges4(valPacked.x);
            vec4 botH = UnpackEdges4(valPacked.y);
            neighbors[1][2] = vec2(botV.x, botH.x);
            neighbors[2][2] = vec2(botV.z, botH.z);
            neighbors[1][0].y = topRow.x;
            neighbors[2][0].y = topRow.y;
            neighbors[0][1].x = leftColumn.x;
            neighbors[0][2].x = leftColumn.y;
            neighbors[1][1] = qe0;
            neighbors[2][1] = qe1;
            neighbors[1][2] = qe2;
            neighbors[2][2] = qe3;
            topRow.x = float((topRow.x - LocalContrastH(0, -1, neighbors)) > edgeThreshold);
            topRow.y = float((topRow.y - LocalContrastH(1, -1, neighbors)) > edgeThreshold);
            leftColumn.x = float((leftColumn.x - LocalContrastV(-1, 0, neighbors)) > edgeThreshold);
            leftColumn.y = float((leftColumn.y - LocalContrastV(-1, 1, neighbors)) > edgeThreshold);
            vec4 ce[4];
            ce[0].x = float((qe0.x - LocalContrastV(0, 0, neighbors)) > edgeThreshold);
            ce[0].y = float((qe0.y - LocalContrastH(0, 0, neighbors)) > edgeThreshold);
            ce[1].x = float((qe1.x - LocalContrastV(1, 0, neighbors)) > edgeThreshold);
            ce[1].y = float((qe1.y - LocalContrastH(1, 0, neighbors)) > edgeThreshold);
            ce[2].x = float((qe2.x - LocalContrastV(0, 1, neighbors)) > edgeThreshold);
            ce[2].y = float((qe2.y - LocalContrastH(0, 1, neighbors)) > edgeThreshold);
            ce[3].x = float((qe3.x - LocalContrastV(1, 1, neighbors)) > edgeThreshold);
            ce[3].y = float((qe3.y - LocalContrastH(1, 1, neighbors)) > edgeThreshold);
            ce[0].z = leftColumn.x;
            ce[1].z = ce[0].x;
            ce[2].z = leftColumn.y;
            ce[3].z = ce[2].x;
            ce[0].w = topRow.x;
            ce[1].w = topRow.y;
            ce[2].w = ce[0].y;
            ce[3].w = ce[1].y;
            for (uint ii_1 = 0u; ii_1 < 4u; ii_1++)
            {
                ivec2 localPixelPos = pixelPos + _625[ii_1];
                vec4 edges = ce[ii_1];
                float edgeSum = (((edges.x * edges.y) + (edges.y * edges.z)) + (edges.z * edges.w)) + (edges.w * edges.x);
                if (edgeSum > 0.0)
                {
                    uint _671 = atomicAdd(_s0_b4.controlBuffer.shapeCandidateCount, 1u);
                    uint counterIndex = _671;
                    _s0_b3.shapeCandidates[counterIndex] = (uint(localPixelPos.x) << 18u) | uint(localPixelPos.y);
                }
                vec4 arg_2 = edges;
                outEdges[ii_1] = PackEdgesBinary(arg_2);
            }
        }
    }
    if (inOutputKernel)
    {
        imageStore(s0_b2, ivec2(pixelPos.x / 2, pixelPos.y), uvec4((outEdges.y << 4u) | outEdges.x));
        imageStore(s0_b2, ivec2(pixelPos.x / 2, pixelPos.y + 1), uvec4((outEdges.w << 4u) | outEdges.z));
    }
}

