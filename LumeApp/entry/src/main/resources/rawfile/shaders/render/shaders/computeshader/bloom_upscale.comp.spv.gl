#version 450
#define SPIRV_CROSS_CONSTANT_ID_256 1u
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct LocalPostProcessPushConstantStruct
{
    vec4 viewportSizeInvSize;
    vec4 factor;
};

#ifndef SPIRV_CROSS_CONSTANT_ID_256
#define SPIRV_CROSS_CONSTANT_ID_256 0u
#endif
const uint CORE_BACKEND_TYPE = SPIRV_CROSS_CONSTANT_ID_256;
uniform float CORE_FLIP_NDC ;
#ifndef SPIRV_CROSS_CONSTANT_ID_0
#define SPIRV_CROSS_CONSTANT_ID_0 0u
#endif
const uint CORE_POST_PROCESS_FLAGS = SPIRV_CROSS_CONSTANT_ID_0;

struct uPostProcessPushConstant
{
    LocalPostProcessPushConstantStruct uPc;
};

uniform uPostProcessPushConstant CORE_PC_0;

layout(binding = 11, rgba16f) uniform readonly image2D s0_b0;
layout(binding = 11, rgba16f) uniform writeonly image2D s0_b0_1;
uniform sampler2D s0_b1_s0_b2;

vec3 BloomUpscale(vec2 uv, vec2 invTexSize, sampler2D SPIRV_Cross_Combinedtexsampl)
{
    vec2 ts = invTexSize * 2.0;
    vec3 color = textureLod(SPIRV_Cross_Combinedtexsampl, uv, 0.0).xyz * 0.5;
    color = (textureLod(SPIRV_Cross_Combinedtexsampl, uv - ts, 0.0).xyz * 0.125) + color;
    color = (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(ts.x, -ts.y), 0.0).xyz * 0.125) + color;
    color = (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(-ts.x, ts.y), 0.0).xyz * 0.125) + color;
    color = (textureLod(SPIRV_Cross_Combinedtexsampl, uv + ts, 0.0).xyz * 0.125) + color;
    return color;
}

vec3 BloomUpscaleHorizontal(vec2 uv, vec2 invTexSize, sampler2D SPIRV_Cross_Combinedtexsampl)
{
    vec2 ts = invTexSize * 2.0;
    vec3 color = textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2((-ts.x) * 3.0, 0.0), 0.0).xyz * 0.0500000007450580596923828125;
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2((-ts.x) * 2.0, 0.0), 0.0).xyz * 0.100000001490116119384765625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(-ts.x, 0.0), 0.0).xyz * 0.1500000059604644775390625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, -ts.y), 0.0).xyz * 0.0500000007450580596923828125);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv, 0.0).xyz * 0.300000011920928955078125);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, ts.y), 0.0).xyz * 0.0500000007450580596923828125);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(ts.x, 0.0), 0.0).xyz * 0.1500000059604644775390625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(ts.x * 2.0, 0.0), 0.0).xyz * 0.100000001490116119384765625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(ts.x * 3.0, 0.0), 0.0).xyz * 0.0500000007450580596923828125);
    return color;
}

vec3 BloomUpscaleVertical(vec2 uv, vec2 invTexSize, sampler2D SPIRV_Cross_Combinedtexsampl)
{
    vec2 ts = invTexSize * 2.0;
    vec3 color = textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, (-ts.y) * 3.0), 0.0).xyz * 0.0500000007450580596923828125;
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, (-ts.y) * 2.0), 0.0).xyz * 0.100000001490116119384765625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, -ts.y), 0.0).xyz * 0.1500000059604644775390625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(-ts.x, 0.0), 0.0).xyz * 0.0500000007450580596923828125);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv, 0.0).xyz * 0.300000011920928955078125);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(ts.x, 0.0), 0.0).xyz * 0.0500000007450580596923828125);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, ts.y), 0.0).xyz * 0.1500000059604644775390625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, ts.y * 2.0), 0.0).xyz * 0.100000001490116119384765625);
    color += (textureLod(SPIRV_Cross_Combinedtexsampl, uv + vec2(0.0, ts.y * 3.0), 0.0).xyz * 0.0500000007450580596923828125);
    return color;
}

void main()
{
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + vec2(0.5)) * CORE_PC_0.uPc.viewportSizeInvSize.zw;
    vec3 color = vec3(0.0);
    if (CORE_PC_0.uPc.factor.x == 0.0)
    {
        vec2 param = uv;
        vec2 param_1 = CORE_PC_0.uPc.viewportSizeInvSize.zw;
        color = BloomUpscale(param, param_1, s0_b1_s0_b2);
    }
    else
    {
        if (CORE_PC_0.uPc.factor.x == 1.0)
        {
            vec2 param_2 = uv;
            vec2 param_3 = CORE_PC_0.uPc.viewportSizeInvSize.zw;
            color = BloomUpscaleHorizontal(param_2, param_3, s0_b1_s0_b2);
        }
        else
        {
            if (CORE_PC_0.uPc.factor.x == 2.0)
            {
                vec2 param_4 = uv;
                vec2 param_5 = CORE_PC_0.uPc.viewportSizeInvSize.zw;
                color = BloomUpscaleVertical(param_4, param_5, s0_b1_s0_b2);
            }
        }
    }
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    vec3 baseColor = imageLoad(s0_b0, coords).xyz;
    float scatter = CORE_PC_0.uPc.factor.w;
    color = min(baseColor + (color * scatter), vec3(64512.0));
    imageStore(s0_b0_1, coords, vec4(color, 1.0));
}

