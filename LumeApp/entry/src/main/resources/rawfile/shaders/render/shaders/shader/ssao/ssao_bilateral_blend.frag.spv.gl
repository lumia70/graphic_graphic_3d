#version 450
#define SPIRV_CROSS_CONSTANT_ID_256 1u

struct DefaultCameraMatrixStruct
{
    mat4 view;
    mat4 proj;
    mat4 viewProj;
    mat4 viewInv;
    mat4 projInv;
    mat4 viewProjInv;
    mat4 viewPrevFrame;
    mat4 projPrevFrame;
    mat4 viewProjPrevFrame;
    mat4 shadowViewProj;
    mat4 shadowViewProjInv;
    vec4 jitter;
    vec4 jitterPrevFrame;
    uvec4 indices;
    uvec4 multiViewIndices;
    vec4 frustumPlanes[6];
    uvec4 counts;
    uvec4 pad0;
    mat4 envProjInv;
    mat4 matPad1;
};

const vec2 _128[5] = vec2[](vec2(0.0), vec2(-1.5, 0.0), vec2(1.5, 0.0), vec2(0.0, -1.5), vec2(0.0, 1.5));
const float _170[5] = float[](1.0, 0.60650002956390380859375, 0.60650002956390380859375, 0.60650002956390380859375, 0.60650002956390380859375);
#ifndef SPIRV_CROSS_CONSTANT_ID_256
#define SPIRV_CROSS_CONSTANT_ID_256 0u
#endif
const uint CORE_BACKEND_TYPE = SPIRV_CROSS_CONSTANT_ID_256;
uniform float CORE_FLIP_NDC ;

layout(std140) uniform s0_b3
{
    DefaultCameraMatrixStruct uCameras[16];
} _s0_b3;

uniform sampler2D s0_b1;
uniform sampler2D s0_b2;
uniform sampler2D s0_b0;

layout(location = 0) in vec2 inUv;
layout(location = 0) out vec4 outColor;

vec2 ExtractNearFar(mat4 proj)
{
    float m22 = proj[2].z;
    float m32 = proj[3].z;
    return vec2(m32 / (m22 - 1.0), m32 / (m22 + 1.0));
}

float linearizeDepth(float depth, float near, float far)
{
    return (2.0 * near) / ((far + near) - (depth * (far - near)));
}

void main()
{
    vec4 originalColor = texture(s0_b1, inUv);
    float centerDepth = texture(s0_b2, inUv).x;
    vec2 nearFar = ExtractNearFar(_s0_b3.uCameras[0].proj);
    float centerLinearDepth = linearizeDepth(centerDepth, nearFar.x, nearFar.y);
    vec2 ssaoTexelSize = vec2(1.0) / vec2(textureSize(s0_b0, 0));
    float totalWeight = 0.0;
    float weightedSSAO = 0.0;
    for (int ii = 0; ii < 5; ii++)
    {
        vec2 sampleUV = inUv + (_128[ii] * ssaoTexelSize);
        float ssaoSample = texture(s0_b0, sampleUV).x;
        float sampleDepth = texture(s0_b2, sampleUV).x;
        float sampleLinearDepth = linearizeDepth(sampleDepth, nearFar.x, nearFar.y);
        float depthDiff = abs(centerLinearDepth - sampleLinearDepth);
        float depthWeight = exp((-(depthDiff * depthDiff)) / 0.5);
        float weight = _170[ii] * depthWeight;
        weightedSSAO += (ssaoSample * weight);
        totalWeight += weight;
    }
    float finalSSAO = weightedSSAO / max(totalWeight, 9.9999997473787516355514526367188e-05);
    vec3 finalColor = originalColor.xyz * finalSSAO;
    outColor = vec4(finalColor, originalColor.w);
}

