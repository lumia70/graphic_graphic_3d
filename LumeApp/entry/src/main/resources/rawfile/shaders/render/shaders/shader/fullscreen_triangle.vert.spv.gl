#version 450
#define SPIRV_CROSS_CONSTANT_ID_256 1u

#ifndef SPIRV_CROSS_CONSTANT_ID_256
#define SPIRV_CROSS_CONSTANT_ID_256 0u
#endif
const uint CORE_BACKEND_TYPE = SPIRV_CROSS_CONSTANT_ID_256;
const uint _57 = (CORE_BACKEND_TYPE & 15u);
const bool _59 = (_57 != 0u);
uniform float CORE_FLIP_NDC ;

layout(location = 0) out vec2 outUv;

void main()
{
    float x = (-1.0) + float((gl_VertexID & 1) << 2);
    float y = 1.0 - float((gl_VertexID & 2) << 1);
    outUv.x = (x + 1.0) * 0.5;
    outUv.y = (y + 1.0) * 0.5;
    gl_Position = vec4(x, y, 0.0, 1.0);
    if (_59)
    {
        gl_Position = vec4(gl_Position.x, gl_Position.y * CORE_FLIP_NDC, (gl_Position.z * 2.0) - gl_Position.w, gl_Position.w);
    }
}

