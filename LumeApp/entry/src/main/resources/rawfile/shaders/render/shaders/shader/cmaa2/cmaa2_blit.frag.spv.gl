#version 450

uniform sampler2D s0_b0;
uniform sampler2D s0_b1;

layout(location = 0) in vec2 inUv;
layout(location = 0) out vec4 outBlit;

void main()
{
    vec4 cmaaValue = textureLod(s0_b0, inUv, 0.0);
    vec4 colorSample = textureLod(s0_b1, inUv, 0.0);
    vec4 _36;
    if (all(equal(cmaaValue.xyz, vec3(0.0))))
    {
        _36 = colorSample;
    }
    else
    {
        _36 = vec4(cmaaValue.xyz, colorSample.w);
    }
    outBlit = _36;
}

