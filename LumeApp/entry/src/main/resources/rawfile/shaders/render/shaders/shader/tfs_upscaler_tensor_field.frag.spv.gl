#version 450
#define SPIRV_CROSS_CONSTANT_ID_256 1u

struct StructureTensor
{
    float edgeStrength;
    float coherence;
    float isotropy;
    vec2 principalDir;
    vec2 orthogonalDir;
};

struct UpscalePushConstantStruct
{
    vec4 inputSize;
    vec4 outputSize;
    float smoothScale;
    float structureSensitivity;
    float edgeSharpness;
    float padding;
};

const ivec2 _246[5] = ivec2[](ivec2(0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
#ifndef SPIRV_CROSS_CONSTANT_ID_256
#define SPIRV_CROSS_CONSTANT_ID_256 0u
#endif
