            depths_1[2] = depth0123_1.z;
            depths_1[3] = depth0123_1.w;
            depths_1[4] = depth3456.y;
            depths_1[5] = depth3456.z;
            depths_1[6] = depth3456.w;
            depths_1[7] = textureLodOffset(s0_b0_s0_b4, inUv, 0.0, ivec2(1, -1)).x;
