    vec3 bc3 = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1, 0)).xyz;
    vec3 bc4 = currColor;
    vec3 bc5 = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(1, 0)).xyz;
    vec3 bc6 = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1, 1)).xyz;
    vec3 bc7 = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(0, 1)).xyz;
    vec3 bc8 = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(1)).xyz;
    if (useyCoCG)
    {
        bc0 = RGBToYCoCg(bc0);
        bc1 = RGBToYCoCg(bc1);
        bc2 = RGBToYCoCg(bc2);
        bc3 = RGBToYCoCg(bc3);
        bc4 = RGBToYCoCg(bc4);
        bc5 = RGBToYCoCg(bc5);
        bc6 = RGBToYCoCg(bc6);
        bc7 = RGBToYCoCg(bc7);
        bc8 = RGBToYCoCg(bc8);
    }
    vec3 min13 = min(min(bc1, bc3), bc4);
    vec3 max13 = max(max(bc1, bc3), bc4);
    vec3 min57 = min(bc5, bc7);
    vec3 max57 = max(bc5, bc7);
    vec3 boxMin = min(min13, min57);
    vec3 boxMax = max(max13, max57);
    vec3 min02 = min(boxMin, min(bc0, bc2));
    vec3 max02 = max(boxMax, max(bc0, bc2));
    vec3 min68 = min(bc6, bc8);
    vec3 max68 = max(bc6, bc8);
    vec3 boxMinCorner = min(min02, min68);
    vec3 boxMaxCorner = max(max02, max68);
    boxMin = (boxMin + boxMinCorner) * 0.5;
    boxMax = (boxMax + boxMaxCorner) * 0.5;
    vec3 clippedHistory;
    if (useyCoCG)
    {
        vec3 historyYCoCg = RGBToYCoCg(history);
        clippedHistory = YCoCgToRGB(clamp(historyYCoCg, boxMin, boxMax));
    }
    else
    {
        clippedHistory = clamp(history, boxMin, boxMax);
    }
    return vec4(clippedHistory, 1.0);
}

vec4 GetHistory(vec2 historyUv, vec4 currColor, bool bicubic, bool useVarianceClipping, bool useyCoCG)
{
    vec4 history;
    if (bicubic)
    {
        vec2 texCoords = (historyUv * CORE_PC_0.uPc.viewportSizeInvSize.xy) - vec2(0.5);
        vec2 fxy = fract(texCoords);
        texCoords -= fxy;
        vec4 xcubic = cubic(fxy.x);
        vec4 ycubic = cubic(fxy.y);
        vec4 c = texCoords.xxyy + vec4(-0.5, 1.5, -0.5, 1.5);
        vec4 s = vec4(xcubic.xz + xcubic.yw, ycubic.xz + ycubic.yw);
        vec4 offset = (c + (vec4(xcubic.yw, ycubic.yw) / s)) * CORE_PC_0.uPc.viewportSizeInvSize.zzww;
        vec4 aa = textureLod(s0_b3_s0_b4, offset.xz, 0.0);
        vec4 bb = textureLod(s0_b3_s0_b4, offset.yz, 0.0);
        vec4 cc = textureLod(s0_b3_s0_b4, offset.xw, 0.0);
        vec4 dd = textureLod(s0_b3_s0_b4, offset.yw, 0.0);
        float sx = s.x / (s.x + s.y);
        float sy = s.z / (s.z + s.w);
        history = mix(mix(dd, cc, vec4(sx)), mix(bb, aa, vec4(sx)), vec4(sy));
    }
    else
    {
        history = textureLod(s0_b3_s0_b4, historyUv, 0.0);
    }
    if (useVarianceClipping)
    {
        history = CalcVarianceClippedHistoryColor(history.xyz, currColor.xyz, useyCoCG);
    }
    else
    {
        history = CalcMinMaxClippedHistoryColor(history.xyz, currColor.xyz, useyCoCG);
    }
    return history;
}

float CalcLuma(vec3 color)
{
    return ((0.2989999949932098388671875 * color.x) + (0.58700001239776611328125 * color.y)) + (0.114000000059604644775390625 * color.z);
