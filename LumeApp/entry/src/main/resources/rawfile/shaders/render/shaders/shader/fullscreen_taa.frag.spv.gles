void UnpackFeatureToggles(out bool useBicubic, out bool useVarianceClipping, out bool useyCoCG, out bool ignoreEdges)
{
    uint combined = floatBitsToUint(CORE_PC_0.uPc.factor.z);
    useBicubic = (combined & 2u) != 0u;
    useVarianceClipping = (combined & 4u) != 0u;
    useyCoCG = (combined & 8u) != 0u;
    ignoreEdges = (combined & 16u) != 0u;
}

vec4 cubic(float value)
{
    vec4 n = vec4(1.0, 2.0, 3.0, 4.0) - vec4(value);
    vec4 s = (n * n) * n;
    float x = s.x;
    float y = s.y - (4.0 * s.x);
    float z = (s.z - (4.0 * s.y)) + (6.0 * s.x);
    float w = ((6.0 - x) - y) - z;
    return vec4(x, y, z, w) * 0.16666667163372039794921875;
}

vec3 RGBToYCoCg(vec3 rgb)
{
    float y = ((0.25 * rgb.x) + (0.5 * rgb.y)) + (0.25 * rgb.z);
    float co = (0.5 * rgb.x) - (0.5 * rgb.z);
    float cg = (((-0.25) * rgb.x) + (0.5 * rgb.y)) - (0.25 * rgb.z);
    return vec3(y, co, cg);
}

vec3 VarianceClipAABB(vec3 history, vec3 currColor, vec3 center, vec3 size)
{
    vec3 offset = history - center;
    vec3 absOffset = abs(offset);
    vec3 extent = max(vec3(0.0), absOffset - size);
    float maxExtent = max(extent.x, max(extent.y, extent.z));
    if (maxExtent > 0.0)
    {
        float scale = 1.0 - (maxExtent / (max(absOffset.x, max(absOffset.y, absOffset.z)) + 9.9999999392252902907785028219223e-09));
        return center + (offset * scale);
    }
    return history;
}

vec3 YCoCgToRGB(vec3 ycocg)
{
    float r = (ycocg.x + ycocg.y) - ycocg.z;
    float g = ycocg.x + ycocg.z;
    float b = (ycocg.x - ycocg.y) - ycocg.z;
    return vec3(r, g, b);
}

vec4 CalcVarianceClippedHistoryColor(vec3 history, vec3 currColor, bool useyCoCG)
{
    uint quality = uint(CORE_PC_0.uPc.factor.y + 0.5);
    uint numSamples = 0u;
    vec3 colors[9];
    if (quality <= 1u)
    {
        numSamples = 5u;
        colors[0] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(0, -1)).xyz;
        colors[1] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1, 0)).xyz;
        colors[2] = currColor;
        colors[3] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(1, 0)).xyz;
        colors[4] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(0, 1)).xyz;
    }
    else
    {
        numSamples = 9u;
        colors[0] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1)).xyz;
        colors[1] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(0, -1)).xyz;
        colors[2] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(1, -1)).xyz;
        colors[3] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1, 0)).xyz;
        colors[4] = currColor;
        colors[5] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(1, 0)).xyz;
        colors[6] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1, 1)).xyz;
        colors[7] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(0, 1)).xyz;
        colors[8] = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(1)).xyz;
    }
    vec3 sum = vec3(0.0);
    vec3 sumSq = vec3(0.0);
    for (int ii = 0; uint(ii) < numSamples; ii++)
    {
        vec3 value = colors[ii];
        if (useyCoCG)
        {
            value = RGBToYCoCg(value);
        }
        sum += value;
        sumSq += (value * value);
    }
    vec3 mean = sum / vec3(float(numSamples));
    vec3 variance = sqrt(max(vec3(0.0), (sumSq / vec3(float(numSamples))) - (mean * mean)));
    vec3 scaledVariance = variance * 1.25;
    vec3 clampedHistoryColor;
    if (useyCoCG)
    {
        clampedHistoryColor = YCoCgToRGB(VarianceClipAABB(RGBToYCoCg(history), RGBToYCoCg(currColor), mean, scaledVariance));
    }
    else
    {
        clampedHistoryColor = VarianceClipAABB(history, currColor, mean, scaledVariance);
    }
    return vec4(clampedHistoryColor, 1.0);
}

vec4 CalcMinMaxClippedHistoryColor(vec3 history, vec3 currColor, bool useyCoCG)
{
    vec3 bc0 = textureLodOffset(s0_b1_s0_b4, inUv, 0.0, ivec2(-1)).xyz;
