float CalculateLineIntegral(FogLayer layer, float rayDirY, float rayOrigY)
{
    float exponent = max(-127.0, layer.fallOff * (rayOrigY - layer.offset));
    float falloff = max(-127.0, layer.fallOff * rayDirY);
    float lineIntegral = (1.0 - exp2(-falloff)) / falloff;
    float lineIntegralTaylor = 0.693147182464599609375 - (0.2402265071868896484375 * falloff);
    return (layer.density * exp2(-exponent)) * ((abs(falloff) > 0.004999999888241291046142578125) ? lineIntegral : lineIntegralTaylor);
}

void InplaceFogBlock(uint flags, vec3 worldPos, vec3 camWorldPos, vec4 inCol, out vec3 outCol)
{
    outCol = inCol.xyz;
    if ((flags & 1u) == 1u)
    {
        vec3 cameraToPointVector = worldPos - camWorldPos;
        float cameraToPointY = cameraToPointVector.y;
        float cameraY = camWorldPos.y;
        float cameraToPointLengthSqr = dot(cameraToPointVector, cameraToPointVector);
        float cameraToPointLengthInv = inversesqrt(cameraToPointLengthSqr);
        float worldDistanceToCamera = cameraToPointLengthSqr * cameraToPointLengthInv;
        float minDistance = _s0_b3.uFogData.baseFactors.x;
        if (minDistance > 0.0)
        {
            float minIntersectionT = minDistance * cameraToPointLengthInv;
            float cameraToMinIntersectionY = minIntersectionT * cameraToPointY;
            cameraToPointY -= cameraToMinIntersectionY;
            cameraY += cameraToMinIntersectionY;
            worldDistanceToCamera = (1.0 - minIntersectionT) * worldDistanceToCamera;
        }
        FogLayer L1 = FogLayer(_s0_b3.uFogData.firstLayer.x, _s0_b3.uFogData.firstLayer.y, _s0_b3.uFogData.firstLayer.z);
        FogLayer param = L1;
        float param_1 = cameraToPointY;
        float param_2 = cameraY;
        float layer1Integral = CalculateLineIntegral(param, param_1, param_2);
        FogLayer L2 = FogLayer(_s0_b3.uFogData.secondLayer.x, _s0_b3.uFogData.secondLayer.y, _s0_b3.uFogData.secondLayer.z);
        FogLayer param_3 = L2;
        float param_4 = cameraToPointY;
        float param_5 = cameraY;
        float layer2Integral = CalculateLineIntegral(param_3, param_4, param_5);
        float exponentialHeightLineIntegral = (layer1Integral + layer2Integral) * worldDistanceToCamera;
        float maxOpacity = _s0_b3.uFogData.baseFactors.z;
        float expFogFactor = min(1.0 - clamp(exp2(-exponentialHeightLineIntegral), 0.0, 1.0), maxOpacity);
        float cutOffDistance = _s0_b3.uFogData.baseFactors.y;
        if ((cutOffDistance > 0.0) && (worldDistanceToCamera > cutOffDistance))
        {
            expFogFactor = 0.0;
        }
        vec4 inscatteringColor = _s0_b3.uFogData.inscatteringColor;
        vec4 envMapColor = _s0_b3.uFogData.envMapFactor;
        vec3 fogColor = (inscatteringColor.xyz * inscatteringColor.w) + (envMapColor.xyz * envMapColor.w);
        vec3 baseColor = inCol.xyz;
        outCol = mix(baseColor, fogColor, vec3(expFogFactor));
    }
}

