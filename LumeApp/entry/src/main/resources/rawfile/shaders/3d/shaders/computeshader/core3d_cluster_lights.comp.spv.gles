uvec3 IdxToCoord(uint idx)
{
    uint z = idx / 144u;
    uint xy = idx % 144u;
    uint y = xy / 16u;
    uint x = xy % 16u;
    return uvec3(x, y, z);
}

vec2 GetNearFar(mat4 projectionMatrix)
{
    float a = projectionMatrix[2].z;
    float b = projectionMatrix[3].z;
    float near = b / (a - 1.0);
    float far = b / (1.0 + a);
    return vec2(near, far);
}

vec4 ScreenPointToView(vec2 screenPoint, vec2 resolution, mat4 invProj)
{
    vec4 ndc = vec4(((screenPoint.x / resolution.x) * 2.0) - 1.0, 1.0 - ((screenPoint.y / resolution.y) * 2.0), 0.0, 1.0);
    vec4 view = invProj * ndc;
    return view / vec4(view.w);
}

vec3 IntersectRayZPlane(vec3 aa, vec3 bb, float zDist)
{
    vec3 dir = bb - aa;
    float tt = (zDist - dot(vec3(0.0, 0.0, -1.0), aa)) / dot(vec3(0.0, 0.0, -1.0), dir);
    vec3 result = aa + (dir * tt);
    return result;
}

void ClusterIdxToClusterCorners(uint clusterIdx, mat4 proj, vec2 resolution, out vec3 minCornerView, out vec3 maxCornerView)
{
    uvec3 coord = IdxToCoord(clusterIdx);
    vec2 nearfar = GetNearFar(proj);
    float zNear = nearfar.x;
    float zFar = nearfar.y;
    float tileSizePxX = resolution.x / 16.0;
    float tileSizePxY = resolution.y / 9.0;
    vec2 minPointSS = vec2(coord.xy) * vec2(tileSizePxX, tileSizePxY);
    vec2 maxPointSS = (vec2(coord.xy) + vec2(1.0)) * vec2(tileSizePxX, tileSizePxY);
    mat4 invProj = inverse(proj);
    vec3 maxPointVS = ScreenPointToView(maxPointSS, resolution, invProj).xyz;
    vec3 minPointVS = ScreenPointToView(minPointSS, resolution, invProj).xyz;
    float tileNear = zNear * pow(zFar / zNear, float(coord.z) / 24.0);
    float tileFar = zNear * pow(zFar / zNear, float(coord.z + 1u) / 24.0);
    vec3 minPointNear = IntersectRayZPlane(vec3(0.0), minPointVS, tileNear);
    vec3 minPointFar = IntersectRayZPlane(vec3(0.0), minPointVS, tileFar);
    vec3 maxPointNear = IntersectRayZPlane(vec3(0.0), maxPointVS, tileNear);
    vec3 maxPointFar = IntersectRayZPlane(vec3(0.0), maxPointVS, tileFar);
    vec3 minPointView = min(minPointNear, minPointFar);
    vec3 maxPointView = max(maxPointNear, maxPointFar);
    minCornerView = minPointView;
    maxCornerView = maxPointView;
}

