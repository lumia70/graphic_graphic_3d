    float closestPointDistance = (cos(coneAngle) * sqrt(lenSq - (v1Len * v1Len))) - (v1Len * sin(coneAngle));
    bool cullAngle = closestPointDistance > boundSphereRadius;
    bool cullFront = v1Len > (boundSphereRadius + coneRange);
