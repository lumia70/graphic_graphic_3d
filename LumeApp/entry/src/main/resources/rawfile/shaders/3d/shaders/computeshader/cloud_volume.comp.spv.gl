vec2 GetRaySphereIntersect(vec3 ro, vec3 rd, float radius, vec3 sphereCenter)
{
    vec3 L = ro - sphereCenter;
    float a = dot(rd, rd);
    float b = 2.0 * dot(rd, L);
    float c = dot(L, L) - (radius * radius);
    float discriminant = (b * b) - ((4.0 * a) * c);
    if (discriminant < 0.0)
