    float sqrtD = sqrt(discriminant);
    float invA = 1.0 / (2.0 * a);
    float t_near = ((-b) - sqrtD) * invA;
    float t_far = ((-b) + sqrtD) * invA;
    return vec2(t_near, t_far);
}

