#version 320 es
#extension GL_OVR_multiview2 : require
#define SPIRV_CROSS_CONSTANT_ID_256 1u
layout(num_views = 1) in;

#ifndef SPIRV_CROSS_CONSTANT_ID_256
#define SPIRV_CROSS_CONSTANT_ID_256 0u
#endif
const uint CORE_BACKEND_TYPE = SPIRV_CROSS_CONSTANT_ID_256;
const uint _106 = (CORE_BACKEND_TYPE & 15u);
const bool _108 = (_106 != 0u);
uniform float CORE_FLIP_NDC ;

layout(location = 0) out vec3 outCubeUv;

mediump vec3 GetCubemapCoord(mediump vec2 uv)
{
    mediump vec3 coords[6] = vec3[](vec3(1.0, -uv.y, -uv.x), vec3(-1.0, -uv.y, uv.x), vec3(uv.x, 1.0, uv.y), vec3(uv.x, -1.0, -uv.y), vec3(uv.x, -uv.y, 1.0), vec3(-uv.x, -uv.y, -1.0));
    uint index = min(uint(gl_ViewID_OVR), 5u);
    return coords[index];
}

void main()
{
    mediump float x = (-1.0) + float((gl_VertexID & 1) << 2);
    mediump float y = 1.0 - float((gl_VertexID & 2) << 1);
    gl_Position = vec4(x, y, 0.0, 1.0);
    if (_108)
    {
        gl_Position = vec4(gl_Position.x, gl_Position.y * CORE_FLIP_NDC, (gl_Position.z * 2.0) - gl_Position.w, gl_Position.w);
    }
    mediump vec2 param = vec2(x, y);
    outCubeUv = GetCubemapCoord(param);
}

