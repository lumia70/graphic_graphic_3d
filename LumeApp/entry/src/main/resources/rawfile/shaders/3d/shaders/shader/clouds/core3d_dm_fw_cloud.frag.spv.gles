#ifndef SPIRV_CROSS_CONSTANT_ID_0
#define SPIRV_CROSS_CONSTANT_ID_0 0u
#endif
const uint CORE_MATERIAL_TYPE = SPIRV_CROSS_CONSTANT_ID_0;
#ifndef SPIRV_CROSS_CONSTANT_ID_1
#define SPIRV_CROSS_CONSTANT_ID_1 0u
#endif
const uint CORE_MATERIAL_FLAGS = SPIRV_CROSS_CONSTANT_ID_1;
#ifndef SPIRV_CROSS_CONSTANT_ID_2
#define SPIRV_CROSS_CONSTANT_ID_2 0u
#endif
const uint CORE_LIGHTING_FLAGS = SPIRV_CROSS_CONSTANT_ID_2;
#ifndef SPIRV_CROSS_CONSTANT_ID_3
#define SPIRV_CROSS_CONSTANT_ID_3 0u
#endif
const uint CORE_POST_PROCESS_FLAGS = SPIRV_CROSS_CONSTANT_ID_3;
#ifndef SPIRV_CROSS_CONSTANT_ID_4
#define SPIRV_CROSS_CONSTANT_ID_4 0u
#endif
const uint CORE_CAMERA_FLAGS = SPIRV_CROSS_CONSTANT_ID_4;

layout(std140) uniform s0_b2
{
    DefaultMaterialEnvironmentStruct uEnvironmentData;
} _s0_b2;

uniform mediump sampler2D s2_b1[10];

layout(location = 0) in vec2 inUv;
layout(location = 1) out vec4 outVelocityNormal;
layout(location = 0) out vec4 outColor;

ivec2 GetTextureSize(uint instanceIdx, uint matTexIdx, int lod)
{
    return textureSize(s2_b1[matTexIdx], lod);
}

vec4 GetTextureSample(vec2 uv, uint instanceIdx, uint matTexIdx)
{
    vec4 _149 = texture(s2_b1[matTexIdx], uv);
    return _149;
}

vec4 GetTexelFetch(ivec2 uv, uint instanceIdx, uint matTexIdx)
{
    vec4 _158 = texelFetch(s2_b1[matTexIdx], uv, 0);
    return _158;
}

vec2 OctWrap(vec2 v)
{
    return (vec2(1.0) - abs(v.yx)) * vec2((v.x >= 0.0) ? 1.0 : (-1.0), (v.y >= 0.0) ? 1.0 : (-1.0));
}

vec2 NormalOctEncode(vec3 normal)
{
    vec3 n = normal;
    n /= vec3((abs(n.x) + abs(n.y)) + abs(n.z));
    vec2 _92;
    if (n.z >= 0.0)
    {
        _92 = n.xy;
    }
    else
    {
        vec2 param = n.xy;
        _92 = OctWrap(param);
    }
    n.x = _92.x;
    n.y = _92.y;
    vec3 _107 = n;
    vec2 _112 = (_107.xy * 0.5) + vec2(0.5);
    n.x = _112.x;
    n.y = _112.y;
    return n.xy;
}

vec4 GetPackVelocityAndNormal(vec2 velocity, vec3 normal)
{
    vec3 param = normal;
    return vec4(velocity, NormalOctEncode(param));
}

void CloudMain()
{
    uint frameIndex = floatBitsToUint(_s0_b2.uEnvironmentData.groundColor.w);
    uint idx = 0u + frameIndex;
    vec2 uvFull = (inUv * 0.5) + vec2(0.5);
    vec2 lowResTexelSize = vec2(1.0) / vec2(GetTextureSize(0u, idx, 0));
    ivec2 lowResTextureSize = GetTextureSize(0u, idx, 0);
    vec2 uvLow = uvFull - (lowResTexelSize * 0.5);
    vec2 lowUV_scaled = uvFull / lowResTexelSize;
    ivec2 base = ivec2(floor(lowUV_scaled));
    vec4 next = GetTextureSample(uvFull, 0u, idx);
    uint depthTexIdx = 2u + frameIndex;
    float centerDepth = GetTextureSample(uvFull, 0u, depthTexIdx).x;
    vec4 totalColor = vec4(0.0);
    float totalWeight = 0.0;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            ivec2 neighborCoord = clamp(base + ivec2(i, j), ivec2(0), lowResTextureSize - ivec2(1));
            vec4 neighborColor = GetTexelFetch(neighborCoord, 0u, idx);
            float neighborDepth = GetTexelFetch(neighborCoord, 0u, depthTexIdx).x;
            float depthDiff = neighborDepth - centerDepth;
            float depthWeight = exp((-(depthDiff * depthDiff)) / 0.180000007152557373046875);
            vec2 neighborUV = (vec2(neighborCoord) + vec2(0.5)) * lowResTexelSize;
            vec2 uvDiff = (uvFull - neighborUV) / lowResTexelSize;
            float distSq = dot(uvDiff, uvDiff);
            float spatialWeight = exp((-distSq) / 5.780000209808349609375);
            float colorDiff = length(neighborColor.xyz - next.xyz);
            float colorWeight = exp((-(colorDiff * colorDiff)) / 8.0);
            float finalWeight = (depthWeight * spatialWeight) * colorWeight;
            totalColor += (neighborColor * finalWeight);
            totalWeight += finalWeight;
        }
    }
    vec2 param = vec2(0.0);
    vec3 param_1 = vec3(0.0);
    outVelocityNormal = GetPackVelocityAndNormal(param, param_1);
    gl_FragDepth = 1.0;
    if (totalWeight < 9.9999997473787516355514526367188e-05)
    {
        outColor = next;
        return;
    }
    outColor = totalColor / vec4(totalWeight);
}

void main()
{
    CloudMain();
}

