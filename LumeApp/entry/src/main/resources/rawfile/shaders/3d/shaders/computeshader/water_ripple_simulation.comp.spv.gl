    float neighborAverageHeight = neighborSum / float(validNeighborCount);
    velocity += ((neighborAverageHeight - previousRippleHeight) * 2.0);
    float randomVariance = Rand(vec2(coord) + vec2(deltaTime)) * 0.5;
    float damping = exp((-(5.0 + randomVariance)) * deltaTime);
    velocity *= damping;
    newRippleHeight += velocity;
    return vec4(clamp(newRippleHeight, -_s0_b0.rippleArgs.waterDepth, _s0_b0.rippleArgs.waterDepth), velocity, 0.0, 0.0);
