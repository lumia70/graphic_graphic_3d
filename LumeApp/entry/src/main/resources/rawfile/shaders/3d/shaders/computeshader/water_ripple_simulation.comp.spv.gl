        float rippleEffect = pow(1.0 - tt, _s0_b0.rippleArgs.turbulenceFactors.y) * sin(((_s0_b0.rippleArgs.turbulenceFactors.x * tt) * 0.5) * 3.1415927410125732421875);
        return (-_s0_b0.rippleArgs.newRippleDepth) * rippleEffect;
    }
    else
    {
        return 0.0;
    }
