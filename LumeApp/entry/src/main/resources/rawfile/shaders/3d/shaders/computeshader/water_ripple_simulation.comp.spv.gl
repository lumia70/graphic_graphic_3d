        }
        float resolutionScale = 512.0;
        newRippleHeight += (((nro * deltaTime) * _s0_b0.rippleArgs.rippleFormationSpeed) * (float(imageDim.x) / resolutionScale));
        newRippleHeight = clamp(newRippleHeight, -_s0_b0.rippleArgs.waterDepth, _s0_b0.rippleArgs.waterDepth);
        if (nro != 0.0)
        {
            return vec4(newRippleHeight, 0.0, 0.0, 0.0);
