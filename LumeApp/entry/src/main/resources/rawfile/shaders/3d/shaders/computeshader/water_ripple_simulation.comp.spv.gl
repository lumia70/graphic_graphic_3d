float Rand(vec2 seed)
{
    return fract(sin(dot(seed, vec2(12.98980045318603515625, 78.233001708984375))) * 43758.546875);
}

vec4 ComputeRipple(ivec2 coord, vec4 rippleData, float deltaTime, ivec2 imageDim, ivec2 offset)
{
    float previousRippleHeight = rippleData.x;
